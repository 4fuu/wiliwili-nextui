#!/bin/sh
# Cross-builds cedar-decode, the on-device H.264 decode tester, against the
# libavcodec that build-deps.sh installed into the toolchain sysroot, and
# installs it into the pak (bin/cedar-decode) so it ships with the app.
#
#   ./scripts/nextui/cedar/make-tester
#
# Run inside the tg5040 toolchain image after build-deps.sh.
set -eu

: "${SYSROOT:?run inside the tg5040 toolchain image (SYSROOT is not set)}"
: "${CROSS_TRIPLE:?run inside the tg5040 toolchain image (CROSS_TRIPLE is not set)}"

CEDAR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$CEDAR/../../.." && pwd)
CC="${CROSS_TRIPLE}-gcc"
mkdir -p "$ROOT/dist"

$CC -std=gnu11 -O2 -Wall -Wextra -Wno-unused-parameter \
    --sysroot="$SYSROOT" \
    -I"$SYSROOT/usr/include" \
    -o "$ROOT/dist/cedar-decode" "$CEDAR/tools/cedar-decode.c" \
    -L"$SYSROOT/usr/lib" -lavcodec -lavutil -Wl,-rpath-link,"$SYSROOT/usr/lib"

echo "==> $ROOT/dist/cedar-decode:"
"${CROSS_TRIPLE}-readelf" -d "$ROOT/dist/cedar-decode" | grep NEEDED
